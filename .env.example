# Copy to .env. Docker: fill the three secrets, then docker compose up -d --build.
# Use separate random values of at least 32 characters for the two API tokens.
# Never commit .env. Values containing $ should be single-quoted for Compose.
POSTGRES_DB=gos_academy
POSTGRES_USER=gos
POSTGRES_PASSWORD=
# Leave empty for Python on the host. Compose overrides this with db in containers.
POSTGRES_HOST=
# Published host port; containers always connect to db:5432.
POSTGRES_PORT=5432
# Only used when running Python directly on the host. URL-encode the password.
# Docker constructs its own URL from POSTGRES_*; do not replace localhost with db here.
DATABASE_URL=postgresql+psycopg://gos:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/gos_academy
MOCK_WEBHOOK_TOKEN=
OPERATOR_API_TOKEN=
LOG_LEVEL=INFO

# Docker image and API binding. Keep localhost for a local demo.
APP_IMAGE=gos-academy-assistant:local
APP_ENV_FILE=.env
API_BIND_HOST=127.0.0.1
API_PORT=8000
# Bootstrap indexes missing documents; existing ready/revoked sources are preserved.
# For the full original corpus, put its files + reviewed manifest in data/raw/,
# then set KNOWLEDGE_MANIFEST=/app/data/raw/manifest.local.json.
KNOWLEDGE_MANIFEST=/app/data/samples/docker-manifest.json
MAINTENANCE_INTERVAL_SECONDS=3600

# PostgreSQL event worker leases and bounded retries.
EVENT_MAX_ATTEMPTS=3
EVENT_LEASE_SECONDS=120
EVENT_BACKOFF_BASE_SECONDS=2
EVENT_BACKOFF_CAP_SECONDS=60
EVENT_POLL_INTERVAL_SECONDS=1
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_LEASE_SECONDS=60

# Ephemeral, same-sender follow-up context; semantic paraphrasing stays disabled.
CONTEXT_TTL_MINUTES=20
CONTEXT_MAX_TURNS=5
CONTEXT_MAX_CHARACTERS=3500

# Staff credentials are issued per actor by scripts.seed_teacher_demo (not a global teacher key).
TEACHER_REPLY_LEASE_SECONDS=60
TEACHER_REPLY_MAX_ATTEMPTS=3
FAQ_OUTPUT_DIR=data/generated/teacher-faq

# Mock webhook quota per sender and group within a fixed time window.
WEBHOOK_SENDER_LIMIT=10
WEBHOOK_GROUP_LIMIT=100
WEBHOOK_RATE_WINDOW_SECONDS=60

# Fixed model/revision/dimension are defined in app/knowledge/embedding_contract.py.
# Docker bundles this model at /opt/models and overrides the cache/output paths.
# Host-only setup: download once with python -m app.knowledge.embeddings --download.
EMBEDDING_CACHE_DIR=.models
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_BATCH_SIZE=16
# CPU thread budget per model process in Docker; no GPU is required.
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
CHUNK_TARGET_TOKENS=320
CHUNK_OVERLAP_TOKENS=40

# Hybrid search budgets. Both SQL legs share the same authorization predicates.
RETRIEVAL_DENSE_CANDIDATES=10
RETRIEVAL_LEXICAL_CANDIDATES=10
RETRIEVAL_MAX_LEXICAL_TERMS=6
RETRIEVAL_RRF_K=60

# Grounded generation: fake is deterministic/offline; gemini calls Google's API.
LLM_PROVIDER=fake
# Switch LLM_PROVIDER to gemini and fill the API key to enable live generation.
# This model was smoke-tested on 2026-11-07; change it for your account if needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_CONTEXT_CHARACTERS=12000
